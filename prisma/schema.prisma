generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AttendanceMethod {
  CHECK_IN
  MANUAL
  IMPORT
}

enum ExcuseStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Student relations
  enrollments  Enrollment[]
  attendances  Attendance[] @relation("StudentAttendance")
  submissions  Submission[] @relation("StudentSubmission")

  // Instructor relations
  trackAssignments TrackInstructor[]

  // Author / Staff relations
  createdSessions       Session[]      @relation("SessionCreator")
  createdAssignments    Assignment[]   @relation("AssignmentCreator")
  authoredAnnouncements Announcement[] @relation("AnnouncementAuthor")
  markedAttendances     Attendance[]   @relation("AttendanceMarker")
  gradedSubmissions     Submission[]   @relation("SubmissionGrader")

  // Chat relations
  sentMessages  Message[]  @relation("MessageSender")
  chatMutes     ChatMute[] @relation("MutedUser")
  issuedMutes   ChatMute[] @relation("MutedByUser")

  // Notification relations
  notifications Notification[]

  // Excuse relations
  submittedExcuses AttendanceExcuse[] @relation("ExcuseSubmitter")
  reviewedExcuses  AttendanceExcuse[] @relation("ExcuseReviewer")

  // Certificate relation
  certificates Certificate[]

  // Audit log relation
  auditLogs AuditLog[]

  // Import relation
  attendanceImports AttendanceImport[] @relation("ImportedBy")

  @@index([email])
}

model Cohort {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tracks        Track[]
  sessions      Session[]
  assignments   Assignment[]
  announcements Announcement[]
  channels      Channel[]
  chatMutes     ChatMute[]
  certificates  Certificate[]
}

model Track {
  id          String   @id @default(cuid())
  cohortId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cohort        Cohort            @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  enrollments   Enrollment[]
  instructors   TrackInstructor[]
  sessions      Session[]
  assignments   Assignment[]
  announcements Announcement[]
  channels      Channel[]
  certificates  Certificate[]

  @@index([cohortId])
}

model Enrollment {
  id        String    @id @default(cuid())
  userId    String
  trackId   String
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  track Track @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([trackId])
}

model TrackInstructor {
  trackId   String
  userId    String
  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([trackId, userId])
}

model Session {
  id           String    @id @default(cuid())
  cohortId     String
  trackId      String?   // null means shared across the entire cohort
  title        String
  description  String?
  startsAt     DateTime
  endsAt       DateTime
  meetingUrl   String?
  recordingUrl String?
  notes        String?
  checkinCode  String?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  cohort      Cohort             @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  track       Track?             @relation(fields: [trackId], references: [id], onDelete: Restrict)
  createdBy   User               @relation("SessionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attendances Attendance[]
  excuses     AttendanceExcuse[]
  imports     AttendanceImport[]

  @@index([cohortId])
  @@index([trackId])
  @@index([startsAt])
}

model Attendance {
  id         String           @id @default(cuid())
  sessionId  String
  userId     String
  status     AttendanceStatus
  method     AttendanceMethod
  markedById String?
  markedAt   DateTime         @default(now())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  session  Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user     User    @relation("StudentAttendance", fields: [userId], references: [id], onDelete: Restrict)
  markedBy User?   @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  excuses  AttendanceExcuse[]

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model Assignment {
  id                  String   @id @default(cuid())
  cohortId            String
  trackId             String?  // null means shared across the cohort
  title               String
  description         String
  dueAt               DateTime
  maxScore            Int      @default(100)
  allowLateSubmission Boolean  @default(true)
  createdById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cohort      Cohort       @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  track       Track?       @relation(fields: [trackId], references: [id], onDelete: Restrict)
  createdBy   User         @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submissions Submission[]
  rubric      Rubric?

  @@index([cohortId])
  @@index([trackId])
  @@index([dueAt])
}

model Submission {
  id            String    @id @default(cuid())
  assignmentId  String
  userId        String
  submissionUrl String?
  fileUrl       String?
  submittedAt   DateTime  @default(now())
  score         Int?
  feedback      String?
  gradedById    String?
  gradedAt      DateTime?
  released      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignment    Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  user          User          @relation("StudentSubmission", fields: [userId], references: [id], onDelete: Restrict)
  gradedBy      User?         @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  rubricScores  RubricScore[]

  @@unique([assignmentId, userId])
  @@index([assignmentId])
  @@index([userId])
}

model Announcement {
  id        String   @id @default(cuid())
  cohortId  String
  trackId   String?  // null means shared across the cohort
  authorId  String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  track  Track? @relation(fields: [trackId], references: [id], onDelete: Restrict)
  author User   @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([cohortId])
  @@index([trackId])
}

// ── Chat ─────────────────────────────────────────────────────────────────────

model Channel {
  id        String   @id @default(cuid())
  cohortId  String
  trackId   String?  // null = general cohort channel
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohort   Cohort    @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  track    Track?    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([cohortId, trackId])
  @@index([cohortId])
  @@index([trackId])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  senderId  String
  body      String
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender  User    @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([channelId])
  @@index([senderId])
  @@index([createdAt])
}

model ChatMute {
  id        String    @id @default(cuid())
  userId    String
  cohortId  String
  trackId   String?   // null = muted from entire cohort
  mutedById String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user    User   @relation("MutedUser", fields: [userId], references: [id], onDelete: Cascade)
  mutedBy User   @relation("MutedByUser", fields: [mutedById], references: [id], onDelete: Restrict)
  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([userId, cohortId])
  @@index([cohortId])
}

// ── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // ASSIGNMENT | GRADE_RELEASED | ANNOUNCEMENT
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ── Rubrics ───────────────────────────────────────────────────────────────────

model Rubric {
  id           String   @id @default(cuid())
  assignmentId String   @unique
  title        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criteria   RubricCriterion[]
}

model RubricCriterion {
  id          String   @id @default(cuid())
  rubricId    String
  title       String
  description String?
  maxScore    Int
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rubric Rubric        @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  scores RubricScore[]

  @@index([rubricId])
}

model RubricScore {
  id           String   @id @default(cuid())
  submissionId String
  criterionId  String
  score        Int
  feedback     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criterion  RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, criterionId])
  @@index([submissionId])
}

// ── Attendance Excuses ────────────────────────────────────────────────────────

model AttendanceExcuse {
  id           String       @id @default(cuid())
  attendanceId String?      // null if attendance record doesn't exist yet
  sessionId    String
  userId       String
  reason       String
  status       ExcuseStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  attendance  Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user        User        @relation("ExcuseSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("ExcuseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@index([status])
}

// ── Attendance Import ─────────────────────────────────────────────────────────

model AttendanceImport {
  id        String   @id @default(cuid())
  sessionId String
  importedById String
  rowCount  Int
  matchedCount Int
  status    String   @default("PENDING_REVIEW") // PENDING_REVIEW | APPLIED | DISCARDED
  rawRows   Json     // parsed CSV rows stored temporarily for review step
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  importedBy User    @relation("ImportedBy", fields: [importedById], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([importedById])
}

// ── Certificates ──────────────────────────────────────────────────────────────

model Certificate {
  id              String   @id @default(cuid())
  userId          String
  cohortId        String
  trackId         String
  certificateCode String   @unique
  issuedAt        DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  track  Track  @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@unique([userId, trackId])
  @@index([userId])
  @@index([cohortId])
}

// ── Audit Log ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}
