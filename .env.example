# ==============================================================================
# GDG LASU Bootcamp LMS — Environment Variables Template
# Copy this file to .env and fill in real values before running or deploying.
# Never commit .env — only .env.example should be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database (Supabase)
# ------------------------------------------------------------------------------

# Transaction-mode pooler — used by the app at runtime (port 6543 for Supabase).
# Required: must include ?pgbouncer=true for PgBouncer transaction mode.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&schema=public"

# Direct session-mode connection — used only for Prisma migrations (port 5432).
# Not needed at app runtime; only required when running `prisma migrate deploy`.
DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication & Session Security
# ------------------------------------------------------------------------------

# Short-lived JWT access token secret (15-minute tokens).
# Generate with: openssl rand -base64 48
# Minimum 32 characters. Must be different from JWT_REFRESH_SECRET.
JWT_ACCESS_SECRET=""

# Long-lived JWT refresh token secret (7-day tokens).
# Generate with: openssl rand -base64 48
# Minimum 32 characters. Must be different from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=""

# ------------------------------------------------------------------------------
# 3. Application URL (optional — only needed if you use absolute URLs in emails)
# ------------------------------------------------------------------------------

# The public base URL of the app in production (no trailing slash).
# Currently not required by the app code; add if you introduce email features.
# NEXT_PUBLIC_APP_URL="https://your-app-domain.com"

# ------------------------------------------------------------------------------
# Notes
# ------------------------------------------------------------------------------
# - File upload / cloud storage is NOT yet configured.
#   Submissions are link-based only. Add storage vars here when implemented.
# - Rate limiting is NOT yet configured.
#   Add infrastructure vars here when Redis or equivalent is introduced.
