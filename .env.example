# ==============================================================================
# GDG LASU Bootcamp LMS — Environment Variables Template
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database (Supabase / Postgres)
# ------------------------------------------------------------------------------
# Transaction-mode connection pooler for runtime app queries
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&schema=public"

# Direct session-mode connection for Prisma migrations and schema sync
DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication & Session Security
# ------------------------------------------------------------------------------
# 32+ character cryptographic secret for signing session JWT tokens
AUTH_SECRET="your-minimum-32-character-secret-key-here"
JWT_ACCESS_SECRET="your-minimum-32-character-access-secret-here"
JWT_REFRESH_SECRET="your-minimum-32-character-refresh-secret-here"

# ------------------------------------------------------------------------------
# 3. Cloudinary Asset & Media Storage
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
